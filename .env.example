# ─── App ───────────────────────────────────────────────
# Public base URL (no trailing slash). Used for certificate verify links,
# Stripe redirects and magic-link callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ──────────────────────────────────────────
# Project URL + anon key (Settings → API). Leave blank to run the public
# site, course, quiz and certificate download without a backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server only, NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ────────────────────────────────────────────
# Leave blank to make the pricing buttons fall back to the lead form.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# One-time Price IDs for each plan (Stripe Dashboard → Products).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=
